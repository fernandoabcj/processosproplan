{
  "_comentario": "Regras para reconhecer as unidades da PROPLAN nas movimentações do SIPAC. A ordem importa: a primeira regra que casar define o setor (a PROPLAN genérica fica por último). 'codigos' aceita o código SIPAC da unidade (ex.: 11.01.07.04) ou um prefixo terminado em '.*' (ex.: 11.00.61.* = qualquer unidade abaixo do Gabinete da PROPLAN). 'padroes' são expressões regulares aplicadas ao nome da unidade em MAIÚSCULAS e sem acentos. No SIPAC/UFPB as unidades da PROPLAN aparecem como 'PROPLAN - NOME (11.01.07.xx)'; não use padrões genéricos como 'COORDENACAO DE ORCAMENTO', que também casam com 'SOF - COORDENACAO DE ORCAMENTO E FINANCAS'.",
  "setores": [
    {
      "sigla": "CODEOR",
      "nome": "Coordenação de Orçamento",
      "codigos": [
        "11.01.07.04"
      ],
      "padroes": [
        "^PROPLAN\\b.*COORDENACAO DE ORCAMENTO",
        "\\bCODEOR\\b"
      ]
    },
    {
      "sigla": "CODEINFO",
      "nome": "Coordenação de Informação",
      "codigos": [
        "11.00.61.01"
      ],
      "padroes": [
        "^PROPLAN\\b.*COORDENACAO DE INFORMAC",
        "\\bCODEINFO\\b"
      ]
    },
    {
      "sigla": "CODECON",
      "nome": "Coordenação de Convênios",
      "codigos": [
        "11.01.07.06"
      ],
      "padroes": [
        "^PROPLAN\\b.*COORDENACAO DE CONVENIOS",
        "\\bCODECON\\b"
      ]
    },
    {
      "sigla": "CODEPLAN",
      "nome": "Coordenação de Planejamento",
      "codigos": [
        "11.01.07.05"
      ],
      "padroes": [
        "^PROPLAN\\b.*COORDENACAO DE PLANEJAMENTO",
        "\\bCODEPLAN\\b"
      ]
    },
    {
      "sigla": "SECRETARIA",
      "nome": "Secretaria Executiva",
      "codigos": [
        "11.00.61.02"
      ],
      "padroes": [
        "^PROPLAN\\b.*SECRETARIA",
        "SECRETARIA.*(PROPLAN|PRO-REITORIA DE PLANEJAMENTO)"
      ]
    },
    {
      "sigla": "PROPLAN",
      "nome": "PROPLAN (Gabinete)",
      "codigos": [
        "11.00.61",
        "11.00.61.*"
      ],
      "padroes": [
        "^PROPLAN\\b",
        "PRO-REITORIA DE PLANEJAMENTO"
      ]
    }
  ],
  "alertas": {
    "dias_parado_no_setor": 15,
    "dias_aguardando_recebimento": 3,
    "passagens_repetidas": 3
  },
  "feriados": []
}